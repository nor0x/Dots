<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:i="using:Avalonia.Xaml.Interactivity"
		xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
		xmlns:hyper="clr-namespace:HyperText.Avalonia.Controls;assembly=HyperText.Avalonia"
		xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
		mc:Ignorable="d"
		d:DesignWidth="700"
		d:DesignHeight="450"
		Width="1200"
		Height="700"
		xmlns:vm="using:Dots.ViewModels"
		xmlns:models="using:Dots.Models"
		xmlns:helpers="using:Dots.Helpers"
		xmlns:data="using:Dots.Data"
		x:Class="Dots.MainWindow"
		x:DataType="vm:MainViewModel"
		Icon="/Assets/iconlogo.png"
		x:Name="PageSelf"
		Title="Dots">
	<Window.Styles>
		<!-- Kept opaque with a hairline border rather than a transparent frame with
			 a real drop shadow: popups are separate native windows, and transparent
			 popup padding needs a compositing WM on X11 or it renders as a black box. -->
		<Style Selector="FlyoutPresenter.DotsFlyout">
			<Setter Property="Background"
					Value="{StaticResource Background}" />
			<Setter Property="BorderThickness"
					Value="1" />
			<Setter Property="BorderBrush"
					Value="{StaticResource HairlineTopBrush}" />
			<Setter Property="CornerRadius"
					Value="8" />
			<Setter Property="Margin"
					Value="0,4,4,0" />
			<Setter Property="Width"
					Value="160" />
		</Style>

	</Window.Styles>
	<Grid RowDefinitions="64,*"
		  Background="{StaticResource Background}">
		<!-- ZIndex is load bearing: root Grid children paint in document order, so
			 the body in row 1 would otherwise paint straight over this shadow.
			 The zero-blur layer doubles as the 1px divider the header lacked. -->
		<Border Grid.Row="0"
				ZIndex="1"
				Background="{StaticResource TopBarBrush}"
				BoxShadow="inset 0 1 0 0 #0Fffffff, 0 1 0 0 #26000000, 0 5 12 -3 #38000000">
		<Grid>
			<StackPanel Orientation="Horizontal"
						Margin="12,4,0,0"
						Spacing="12">
				<Image x:Name="img"
					   ZIndex="99999"
					   Source="/Assets/logo.png"
					   Height="50"
					   Margin="0,-5,0,0"
					   Tapped="Logo_Tapped">
					<Image.Styles>
						<Style Selector="Image">
							<Setter Property="Transitions">
								<Transitions>
									<TransformOperationsTransition Property="RenderTransform"
																   Duration="0:0:0.15"
																   Easing="CircularEaseInOut" />
								</Transitions>
							</Setter>
						</Style>
						<Style Selector="Image:pointerover">
							<Style.Setters>
								<Setter Property="RenderTransform"
										Value="scale(0.9)" />
							</Style.Setters>
						</Style>
						<Style Selector="Image">
							<Style.Setters>
								<Setter Property="RenderTransform"
										Value="scale(1.0)" />

							</Style.Setters>
						</Style>

					</Image.Styles>
				</Image>
				<StackPanel Orientation="Vertical" VerticalAlignment="Center">
					<TextBlock Text="Dots"
							   FontFamily="{StaticResource DottedFont}"
							   TextAlignment="Left"
							   Margin="0,0,0,0"
							   FontSize="32" />
					<TextBlock FontSize="14"
							   Classes="Secondary"
							   TextAlignment="Left"
							   FontFamily="{StaticResource SpaceGrotesk}">
						<Run Text="Updated at" />
						<Run Text="{Binding LastUpdated}" />
					</TextBlock>
				</StackPanel>
			</StackPanel>
			<!-- TextBox is a TemplatedControl and has no BoxShadow, so the recess
				 lives on a wrapping Border. Fluent repaints PART_BorderElement on
				 hover/focus, hence the Transparent overrides below. -->
			<Border Classes="Well"
					Width="320"
					Height="32"
					CornerRadius="6"
					Background="{StaticResource BackgroundDarker}"
					VerticalAlignment="Center">
				<Border.Styles>
					<Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
						<Setter Property="Background"
								Value="Transparent" />
					</Style>
					<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
						<Setter Property="Background"
								Value="Transparent" />
					</Style>
				</Border.Styles>
				<TextBox x:Name="MainSearchBar"
						 Background="Transparent"
						 BorderThickness="0"
						 TextChanged="TextBox_TextChanged"
						 FontFamily="{StaticResource SpaceGrotesk}"
						 FontSize="12"
						 VerticalContentAlignment="Center"
						 VerticalAlignment="Center"
						 Watermark="Search..." />
			</Border>
			<StackPanel Orientation="Horizontal"
						IsVisible="true"
						Spacing="8"
						Margin="0,0,12,0"
						HorizontalAlignment="Right">
				<Button IsVisible="true"
						Classes="Toolbar"
						Background="Transparent"
						Foreground="White"
						Padding="0"
						FontSize="15"
						Tapped="CleanupButton_Click"
						HorizontalContentAlignment="Center"
						VerticalContentAlignment="Center"
						VerticalAlignment="Center"
						ToolTip.Tip="Remove out of date SDKs"
						Width="42"
						Height="42">
					<StackPanel>
						<TextBlock Text="{x:Static helpers:LucideIcons.PackageMinus}" FontFamily="{StaticResource LucideIcons}" HorizontalAlignment="Center" FontSize="16"  />
						<TextBlock Text="Cleanup" FontSize="9" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
				<Button IsVisible="true"
						Classes="Toolbar"
						Background="Transparent"
						Foreground="White"
						Padding="0"
						Tapped="UpdateAndCleanupButton_Click"
						HorizontalContentAlignment="Center"
						VerticalContentAlignment="Center"
						VerticalAlignment="Center"
						ToolTip.Tip="Update to the latest stable SDKs"
						Width="42"
						Height="42">
					<StackPanel>
						<TextBlock Text="{x:Static helpers:LucideIcons.CircleFadingArrowUp}" FontFamily="{StaticResource LucideIcons}" HorizontalAlignment="Center" FontSize="16"  />
						<TextBlock Text="Update" FontSize="9" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
				<Grid Width="1"
					  Background="{StaticResource BackgroundLighter}"
					  Opacity="0.5"
					  Height="42" />
				<Button x:Name="FilterButton"
						Grid.Column="0"
						Classes="Toolbar"
						Background="Transparent"
						Foreground="White"
						HorizontalContentAlignment="Center"
						VerticalContentAlignment="Center"
						VerticalAlignment="Center"
						ToolTip.Tip="Filter SDKs"
						Width="42"
						Height="42">
					<StackPanel>
						<TextBlock Text="{Binding SelectedFilterIcon}" FontFamily="{StaticResource LucideIcons}" HorizontalAlignment="Center" FontSize="16"  />
						<TextBlock Text="Filter" FontSize="9" HorizontalAlignment="Center" />
					</StackPanel>
					<Button.Flyout>
						<Flyout Placement="BottomEdgeAlignedRight"
								FlyoutPresenterClasses="DotsFlyout">
							<StackPanel Background="{StaticResource Background}">
								<Button HorizontalAlignment="Stretch"
										Command="{Binding ApplyFilterCommand}"
										CommandParameter="0"
										Tapped="Filter_Tapped">
									<StackPanel Orientation="Horizontal"
												Height="20"
												Margin="4">
										<TextBlock Text="{x:Static helpers:LucideIcons.ListFilter}"
												   FontFamily="{StaticResource LucideIcons}"
												   VerticalAlignment="Center"
												   FontSize="16"
												   Margin="0,0,8,0" />
										<TextBlock Text="All" FontSize="9" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
								<Button HorizontalAlignment="Stretch"
										Command="{Binding ApplyFilterCommand}"
										CommandParameter="1"
										Tapped="Filter_Tapped">
									<StackPanel Orientation="Horizontal"
												Height="20"
												Margin="4">
										<TextBlock Text="{x:Static helpers:LucideIcons.Cloudy}"
												   FontFamily="{StaticResource LucideIcons}"
												   VerticalAlignment="Center"
												   FontSize="16"
												   Margin="0,0,8,0" />
										<TextBlock Text="Online" FontSize="9" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
								<Button HorizontalAlignment="Stretch"
										Command="{Binding ApplyFilterCommand}"
										CommandParameter="2"
										Tapped="Filter_Tapped">
									<StackPanel Orientation="Horizontal"
												Height="20"
												Margin="4">
										<TextBlock Text="{x:Static helpers:LucideIcons.HardDrive}"
												   FontFamily="{StaticResource LucideIcons}"
												   VerticalAlignment="Center"
												   FontSize="16"
												   Margin="0,0,8,0" />
										<TextBlock Text="Installed" FontSize="9" VerticalAlignment="Center" />

									</StackPanel>
								</Button>

							</StackPanel>
						</Flyout>
					</Button.Flyout>
				</Button>
				<Button Classes="Toolbar"
						Background="Transparent"
						Foreground="White"
						Padding="0"
						Command="{Binding ListSdksCommand}"
						HorizontalContentAlignment="Center"
						VerticalContentAlignment="Center"
						VerticalAlignment="Center"
						Width="42"
						Height="42">
					<StackPanel>
						<TextBlock Text="{x:Static helpers:LucideIcons.RefreshCcw}" FontFamily="{StaticResource LucideIcons}" HorizontalAlignment="Center" FontSize="16"  />
						<TextBlock Text="Refresh" FontSize="9" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
				<Button Classes="Toolbar"
						Background="Transparent"
						IsVisible="{Binding UpdateAvailable}"
						ToolTip.Tip="{Binding AvailableVersion}"
						Foreground="White"
						Padding="0"
						Command="{Binding InstallAppUpdateCommand}"
						HorizontalContentAlignment="Center"
						VerticalContentAlignment="Center"
						VerticalAlignment="Center"
						Width="62"
						Height="42">
					<StackPanel>
						<TextBlock Text="{x:Static helpers:LucideIcons.CircleFadingArrowUp}" FontFamily="{StaticResource LucideIcons}" HorizontalAlignment="Center" FontSize="16"  />
						<TextBlock Text="Update Dots" FontSize="9" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
				<Button Classes="Toolbar"
						Background="Transparent"
						IsVisible="false"
						Foreground="White"
						Padding="0"
						Command="{Binding OpenSettingsCommand}"
						HorizontalContentAlignment="Center"
						VerticalContentAlignment="Center"
						VerticalAlignment="Center"
						Width="42"
						Height="42">
					<StackPanel>
						<TextBlock Text="{x:Static helpers:LucideIcons.Wrench}" FontFamily="{StaticResource LucideIcons}" HorizontalAlignment="Center" FontSize="16"  />
						<TextBlock Text="Settings" FontSize="9" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>
		</Border>
		<Grid Grid.Row="1"
			  ColumnDefinitions="*,Auto"
			  Background="{StaticResource BackgroundSubtle}">
			<SplitView x:Name="MainSplitView"
					   IsPaneOpen="{Binding ShowDetails}"
					   PanePlacement="Right"
					   CompactPaneLength="0"
					   DisplayMode="CompactInline"
					   OpenPaneLength="280">
				<SplitView.Content>
					<Grid RowDefinitions="Auto,*,20">
						<Grid
						x:Name="SelectionInfoContainer"
						Height="0"
						Grid.Row="0">
							<Button x:Name="CloseSelectionInfoButton" Classes="Chrome" Background="Transparent"
									Tapped="CloseSelectionInfoButton_Tapped"
									HorizontalAlignment="Right"
									Foreground="White"
									VerticalAlignment="Top"
									Content="{x:Static helpers:LucideIcons.x}" FontFamily="{StaticResource LucideIcons}" />
							<StackPanel x:Name="SelectionInfoBox"
										ClipToBounds="True"
										Margin="8"
										Spacing="12">

								<TextBlock x:Name="SelectionInfoText"
										   HorizontalAlignment="Left"
										   MaxLines="4"
										   TextWrapping="Wrap"
										   Text="Lorem Ipsum Sunt magni nostrum quae voluptatum eveniet aliquid. Possimus cumque enim voluptatum perspiciatis optio ratione veritatis inventore. Similique blanditiis rem sint quam eveniet."
										   Grid.Column="0" />
								<Button x:Name="SelectionInfoButton"
										Classes="Action"
										Content="Cleanup"
										Background="{StaticResource Success}"
										Foreground="White"
										Width="120"
										HorizontalContentAlignment="Center"
										Grid.Column="1" />
								<Border Height="1" HorizontalAlignment="Stretch" Background="{StaticResource Background}" />
							</StackPanel>
						</Grid>
						<ListBox x:Name="SdkList"
								 Grid.Row="1"
								 ItemsSource="{Binding Sdks.View}"
								 Background="Transparent">
							<ListBox.Styles>
								<!--
									Rows carry a surface at rest but no blur - the inset hairline is a
									solid draw, so a full screen of rows costs nothing. Only the hovered
									and selected row get a real shadow, which caps us at two blurred
									rows and keeps shadows off the scrolling viewport edges.
									All four states keep three shadows with inset at index 0 so
									BoxShadowsTransition interpolates instead of snapping.
								-->
								<Style Selector="ListBoxItem">
									<Setter Property="Margin"
											Value="8,2" />
									<Setter Property="Padding"
											Value="12,8" />
								</Style>
								<Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
									<Setter Property="CornerRadius"
											Value="8" />
									<Setter Property="Background"
											Value="{StaticResource RowRestBrush}" />
									<Setter Property="BoxShadow"
											Value="inset 0 1 0 0 #0Fffffff, 0 1 1 0 #00000000, 0 2 6 -1 #00000000" />
									<Setter Property="Transitions">
										<Transitions>
											<BoxShadowsTransition Property="BoxShadow"
																  Duration="0:0:0.13"
																  Easing="CubicEaseOut" />
											<BrushTransition Property="Background"
															 Duration="0:0:0.13" />
										</Transitions>
									</Setter>
								</Style>
								<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
									<Setter Property="Background"
											Value="{StaticResource RowHoverBrush}" />
									<Setter Property="BoxShadow"
											Value="inset 0 1 0 0 #14ffffff, 0 1 2 0 #26000000, 0 3 8 -2 #33000000" />
								</Style>
								<Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
									<Setter Property="Background"
											Value="{StaticResource BackgroundBrush}" />
									<Setter Property="BoxShadow"
											Value="inset 0 1 0 0 #14ffffff, 0 1 2 0 #26000000, 0 3 8 -2 #33000000" />
								</Style>
								<Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
									<Setter Property="Background"
											Value="{StaticResource BackgroundLighterBrush}" />
									<Setter Property="BoxShadow"
											Value="inset 0 1 0 0 #1Fffffff, 0 2 3 -1 #33000000, 0 6 14 -2 #3D000000" />
								</Style>
							</ListBox.Styles>
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="models:Sdk">
									<Grid Tapped="SdkItem_Tapped"
										  Height="44"
										  Background="Transparent"
										  ColumnDefinitions="Auto,*,Auto"
										  Margin="0,0,4,0">
										<Border Width="44"
												Height="44"
												Classes="Dot"
												Background="{Binding Color}"
												BorderThickness="0"
												CornerRadius="22">
											<Panel>
												<Border CornerRadius="22"
														Background="{StaticResource DotSheen}" />
												<TextBlock Text="{Binding Group}"
														   FontFamily="{StaticResource DottedFont}"
														   FontSize="32"
														   HorizontalAlignment="Center"
														   VerticalAlignment="Center" />
											</Panel>
										</Border>
										<StackPanel Orientation="Vertical"
													VerticalAlignment="Center"
													Grid.Column="1"
													Margin="8,0,0,0">
											<TextBlock Text="{Binding VersionDisplay}" />
											<TextBlock Text="{Binding Path}"
													   Classes="Secondary"
													   IsVisible="{Binding Path, Converter={StaticResource StringIsNullOrEmptyConverter}}"
													   FontSize="11" />
										</StackPanel>
										<StackPanel Orientation="Horizontal"
													Grid.Column="2"
													VerticalAlignment="Center">
											<Border Classes="Pill"
													Background="{StaticResource Danger}"
													IsVisible="{Binding Data.Security}">
												<TextBlock VerticalAlignment="Center"
														   Text="Security Patch"
														   FontSize="10" />
											</Border>
											<Border Classes="Pill"
													IsVisible="{Binding Data.Preview}">
												<Border.Background>
													<SolidColorBrush Color="{Binding SdkData.Version, Converter={StaticResource PreviewTypeToColorConverter}}" />
												</Border.Background>
												<TextBlock VerticalAlignment="Center"
														   Text="{Binding SdkData.Version, Converter={StaticResource PreviewTypeToStringConverter}}"
														   FontSize="10" />
											</Border>
											<Border Classes="Pill"
													IsVisible="{Binding ShowSupportPhase}">
												<Border.Background>
													<SolidColorBrush Color="{Binding Data.SupportPhase, Converter={StaticResource SupportPhaseToColorConverter}}" />
												</Border.Background>
												<TextBlock VerticalAlignment="Center"
														   Text="{Binding Data.SupportPhase}"
														   FontSize="10" />
											</Border>
											<Border Classes="Pill">
												<Border.Background>
													<SolidColorBrush Color="{Binding Data.ReleaseType, Converter={StaticResource ReleaseTypeToColorConverter}}" />
												</Border.Background>
												<TextBlock VerticalAlignment="Center"
														   Text="{Binding Data.ReleaseType}"
														   FontSize="10" />
											</Border>
											<StackPanel>
												<StackPanel Width="230"
															IsVisible="{Binding IsBusy}">
													<TextBlock Text="{Binding StatusMessage}"
															   HorizontalAlignment="Center" />
													<StackPanel Orientation="Horizontal">
														<ProgressBar IsIndeterminate="false"
																	 Minimum="0"
																	 Maximum="100"
																	 ShowProgressText="true"
																	 Value="{Binding ProgressTask.Value}"
																	 Height="20"
																	 Margin="6,0,6,0"
																	 Foreground="White"
																	 IsVisible="True"
																	 HorizontalAlignment="Center" />
														<Button Background="Transparent"
																Foreground="White"
																Padding="0"
																Content="{x:Static helpers:LucideIcons.CircleX}"
																Command="{ReflectionBinding ElementName=PageSelf, Path=DataContext.CancelTaskCommand}"
																CommandParameter="{Binding .}"
																FontFamily="{StaticResource LucideIcons}"
																FontSize="15"
																HorizontalContentAlignment="Center"
																VerticalContentAlignment="Center"
																Width="30"
																Height="30" />
													</StackPanel>
												</StackPanel>
												<StackPanel Orientation="Horizontal"
															IsVisible="{Binding !IsBusy}">
													<Button Padding="0"
															Classes="Action"
															HorizontalContentAlignment="Center"
															VerticalContentAlignment="Center"
															Height="32"
															Width="100"
															FontSize="12"
															Background="{StaticResource Neutral}"
															Foreground="White"
															Margin="12,0,6,0"
															FontFamily="Default"
															VerticalAlignment="Center"
															Command="{ReflectionBinding ElementName=PageSelf, Path=DataContext.OpenOrDownloadCommand}"
															CommandParameter="{Binding .}"
															Classes.Installed="{Binding Installed}"
															Classes.NotInstalled="{Binding !Installed}"
															Grid.Column="2">
														<Button.Styles>
															<Style Selector="Button.Installed">
																<Style.Setters>
																	<Setter Property="Content"
																			Value="Open" />
																</Style.Setters>
															</Style>
															<Style Selector="Button.NotInstalled">
																<Style.Setters>
																	<Setter Property="Content"
																			Value="Download" />
																</Style.Setters>
															</Style>
														</Button.Styles>
													</Button>
													<Button Height="32"
															Width="100"
															Classes="Action"
															FontSize="12"
															Foreground="White"
															Margin="0,0,12,0"
															Padding="0"
															HorizontalContentAlignment="Center"
															VerticalContentAlignment="Center"
															FontFamily="Default"
															VerticalAlignment="Center"
															Command="{ReflectionBinding ElementName=PageSelf, Path=DataContext.InstallOrUninstallCommand}"
															CommandParameter="{Binding .}"
															Classes.Installed="{Binding Installed}"
															Classes.NotInstalled="{Binding !Installed}"
															Grid.Column="2">
														<Button.Styles>
															<Style Selector="Button.Installed">
																<Style.Setters>
																	<Setter Property="Background"
																			Value="{StaticResource Danger}" />
																</Style.Setters>
															</Style>
															<Style Selector="Button.NotInstalled">
																<Style.Setters>
																	<Setter Property="Background"
																			Value="{StaticResource Accent}" />
																</Style.Setters>
															</Style>
															<Style Selector="Button.Installed">
																<Style.Setters>
																	<Setter Property="Content"
																			Value="Uninstall" />
																</Style.Setters>
															</Style>
															<Style Selector="Button.NotInstalled">
																<Style.Setters>
																	<Setter Property="Content"
																			Value="Install" />
																</Style.Setters>
															</Style>
														</Button.Styles>
													</Button>
												</StackPanel>
											</StackPanel>
										</StackPanel>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<!-- pinned to the bottom, so it casts upward -->
						<Border Grid.Row="2" Background="{StaticResource Background}" Height="20" VerticalAlignment="Bottom"
								BoxShadow="inset 0 -1 0 0 #0Fffffff, 0 -1 0 0 #1F000000, 0 -3 8 -2 #2E000000">
							<Grid ColumnDefinitions="20,*">
								<TextBlock FontFamily="{StaticResource LucideIcons}" Grid.Column="0"
										   VerticalAlignment="Center"
										   Margin="8,0,0,0"
										   Text="{Binding CurrentStatusIcon}"
										   Foreground="White" FontSize="10" />
								<TextBlock Text="{Binding CurrentStatusText}" Margin="8,0,0,0" Foreground="White" Grid.Column="1" FontSize="9" VerticalAlignment="Center" />
							</Grid>
						</Border>
						<!-- A real shadow cast by the pane would be clipped at the pane's own
							 bounds - SplitView lays the two sides out as separate subtrees - so
							 the content side draws the falloff itself. -->
						<Border Grid.Row="1"
								Width="6"
								HorizontalAlignment="Right"
								IsHitTestVisible="False"
								IsVisible="{Binding ShowDetails}"
								Background="{StaticResource EdgeShadowRight}" />
						<!-- Lives on the content side rather than inside the pane so it can
							 overhang the list instead of being clipped by it - that also lets
							 CompactPaneLength be 0, so there is no empty gutter when the pane
							 is open. Right aligned keeps it flush to the pane edge in both
							 states, since CompactInline insets the content by the pane width.
							 Drawn last so it sits above the edge falloff. -->
						<Button Grid.Row="0"
								Grid.RowSpan="2"
								Classes="PaneToggle"
								Background="{StaticResource Background}"
								Foreground="White"
								Content="{x:Static helpers:LucideIcons.ChevronLeft}"
								FontFamily="{StaticResource LucideIcons}"
								FontSize="15"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								VerticalAlignment="Bottom"
								BorderThickness="0"
								HorizontalAlignment="Right"
								Width="30"
								Height="40"
								CornerRadius="8,0,0,0"
								Padding="0"
								x:Name="ToggleDetailsButton"
								Tapped="ToggleDetails_Tapped" />
					</Grid>
				</SplitView.Content>
				<SplitView.Pane>
					<Grid ColumnDefinitions="1,*"
						  Background="{StaticResource BackgroundSubtle}">

						<Border Grid.Column="0"
								Width="1"
								Background="{StaticResource HairlineTopBrush}"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch" />
						<Grid x:Name="DetailsPanel"
							  Grid.Column="1"
							  Background="{StaticResource BackgroundSubtle}"
							  DataContext="{Binding SelectedSdk}">
							<!-- EMPTY -->
							<Border Margin="12"
									CornerRadius="8"
									VerticalAlignment="Center"
									IsVisible="{ReflectionBinding ElementName=PageSelf, Path=DataContext.SelectedSdk, Converter={x:Static ObjectConverters.IsNull}}">
								<StackPanel Margin="20">
									<Image Source="/Assets/logo_nothing.png"
										   Stretch="UniformToFill"
										   Margin="20,0,20,20" />
									<TextBlock Text="It's empty here"
											   HorizontalAlignment="Center"
											   FontFamily="{StaticResource SpaceGroteskBold}" />
									<TextBlock Text="Select an SDK to view details"
											   HorizontalAlignment="Center" />
								</StackPanel>
							</Border>
							<ScrollViewer IsVisible="{ReflectionBinding ElementName=PageSelf, Path=DataContext.SelectedSdk, Converter={x:Static ObjectConverters.IsNotNull}}">
								<StackPanel>
									<!-- DATA IS NULL -->
									<StackPanel IsVisible="{ReflectionBinding ElementName=PageSelf, Path=DataContext.SelectedSdk.Data, Converter={x:Static ObjectConverters.IsNull}}"
												Margin="12"
												Spacing="12">
										<!-- Header Card -->
										<Border Classes="Card">
											<StackPanel>
												<Border Width="70"
														Height="70"
														Classes="DotLarge"
														Background="{Binding Color}"
														CornerRadius="35"
														Margin="0,0,0,6">
													<Panel>
														<Border CornerRadius="35"
																Background="{StaticResource DotSheen}" />
														<TextBlock Text="{Binding Group}"
																   FontFamily="{StaticResource DottedFont}"
																   FontSize="32"
																   HorizontalAlignment="Center"
																   VerticalAlignment="Center" />
													</Panel>
												</Border>
												<TextBlock Text="{Binding VersionDisplay}"
														   FontSize="20" />
												<TextBlock Margin="0,5,0,5"
														   Text="{Binding Path}"
														   Tapped="PathTextBlock_Tapped"
														   FontSize="11">
													<TextBlock.Styles>
														<Style Selector="TextBlock">
															<Style.Setters>
																<Setter Property="Foreground"
																		Value="{StaticResource Link}" />
															</Style.Setters>
														</Style>
														<Style Selector="TextBlock:pointerover">
															<Style.Setters>
																<Setter Property="Foreground"
																		Value="{StaticResource LinkHover}" />
																<Setter Property="TextDecorations"
																		Value="Underline" />
																<Setter Property="Cursor"
																		Value="Hand" />
															</Style.Setters>
														</Style>
													</TextBlock.Styles>
												</TextBlock>
											</StackPanel>
										</Border>
										<!-- Empty Info Card -->
										<Border Classes="Card">
											<StackPanel>
												<Image Source="/Assets/logo_nothing.png"
													   Stretch="UniformToFill"
													   Margin="20,0,20,20" />
												<TextBlock Text="It's empty here"
														   HorizontalAlignment="Center"
														   FontFamily="{StaticResource SpaceGroteskBold}" />
												<TextBlock Text="there is not much information about this SDK"
														   HorizontalAlignment="Center" />
											</StackPanel>
										</Border>
									</StackPanel>

									<!-- DATA -->
									<StackPanel x:DataType="models:Sdk"
												Margin="12"
												Spacing="12"
												IsVisible="{ReflectionBinding ElementName=PageSelf, Path=DataContext.SelectedSdk.Data, Converter={x:Static ObjectConverters.IsNotNull}}">
										<!-- Header Card -->
										<Border Classes="Card">
											<StackPanel>
												<Border Width="70"
														Height="70"
														Classes="DotLarge"
														Background="{Binding Color}"
														CornerRadius="35"
														Margin="0,0,0,6">
													<Panel>
														<Border CornerRadius="35"
																Background="{StaticResource DotSheen}" />
														<TextBlock Text="{Binding Group}"
																   FontFamily="{StaticResource DottedFont}"
																   FontSize="52"
																   HorizontalAlignment="Center"
																   VerticalAlignment="Center" />
													</Panel>
												</Border>
												<TextBlock FontSize="20" TextWrapping="Wrap" HorizontalAlignment="Left">
													<Run Text=".NET" />
													<Run Text="{Binding VersionDisplay}" />
												</TextBlock>
												<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
													<Border Classes="Pill"
															Background="{StaticResource Danger}"
															IsVisible="{Binding Data.Security}">
														<TextBlock VerticalAlignment="Center"
																   Text="Security Patch"
																   FontSize="10" />
													</Border>
													<Border Classes="Pill"
															IsVisible="{Binding Data.Preview}">
														<Border.Background>
															<SolidColorBrush Color="{Binding SdkData.Version, Converter={StaticResource PreviewTypeToColorConverter}}" />
														</Border.Background>
														<TextBlock VerticalAlignment="Center"
																   Text="{Binding SdkData.Version, Converter={StaticResource PreviewTypeToStringConverter}}"
																   FontSize="10" />
													</Border>
													<Border Classes="Pill"
															IsVisible="{Binding ShowSupportPhase}">
														<Border.Background>
															<SolidColorBrush Color="{Binding Data.SupportPhase, Converter={StaticResource SupportPhaseToColorConverter}}" />
														</Border.Background>
														<TextBlock VerticalAlignment="Center"
																   Text="{Binding Data.SupportPhase}"
																   FontSize="10" />
													</Border>
													<Border Classes="Pill">
														<Border.Background>
															<SolidColorBrush Color="{Binding Data.ReleaseType, Converter={StaticResource ReleaseTypeToColorConverter}}" />
														</Border.Background>
														<TextBlock VerticalAlignment="Center"
																   Text="{Binding Data.ReleaseType}"
																   FontSize="10" />
													</Border>
												</StackPanel>
												<TextBlock Margin="0,8,0,0"
														   Text="{Binding Path}"
														   Tapped="PathTextBlock_Tapped"
														   FontSize="11">
													<TextBlock.Styles>
														<Style Selector="TextBlock">
															<Style.Setters>
																<Setter Property="Foreground"
																		Value="{StaticResource Link}" />
															</Style.Setters>
														</Style>
														<Style Selector="TextBlock:pointerover">
															<Style.Setters>
																<Setter Property="Foreground"
																		Value="{StaticResource LinkHover}" />
																<Setter Property="TextDecorations"
																		Value="Underline" />
																<Setter Property="Cursor"
																		Value="Hand" />
															</Style.Setters>
														</Style>
													</TextBlock.Styles>
												</TextBlock>
												<!-- Progress / Busy State -->
												<StackPanel HorizontalAlignment="Left"
															Margin="0,8,0,0"
															Width="230"
															Spacing="4"
															IsVisible="{Binding IsBusy}">
													<TextBlock Text="{Binding StatusMessage}"
															   HorizontalAlignment="Center" />
													<StackPanel Orientation="Horizontal">
														<ProgressBar IsIndeterminate="false"
																	 Value="{Binding ProgressTask.Value}"
																	 Minimum="0"
																	 Maximum="100"
																	 ShowProgressText="True"
																	 Height="20"
																	 Margin="6,0,6,0"
																	 Foreground="White"
																	 IsVisible="True"
																	 HorizontalAlignment="Center" />
														<Button Background="Transparent"
																Foreground="White"
																Padding="0"
																Content="{x:Static helpers:LucideIcons.CircleX}"
																Command="{ReflectionBinding ElementName=PageSelf, Path=DataContext.CancelTaskCommand}"
																CommandParameter="{Binding .}"
																FontFamily="{StaticResource LucideIcons}"
																FontSize="15"
																HorizontalContentAlignment="Center"
																VerticalContentAlignment="Center"
																Width="30"
																Height="30" />
													</StackPanel>
												</StackPanel>
												<!-- Action Buttons -->
												<StackPanel Orientation="Horizontal"
															Margin="0,8,0,0"
															VerticalAlignment="Center"
															IsVisible="{Binding !IsBusy}">
													<Button Height="32"
															Width="100"
															Classes="Action"
															Background="{StaticResource Neutral}"
															Padding="0"
															FontSize="12"
															HorizontalContentAlignment="Center"
															VerticalContentAlignment="Center"
															Margin="0,0,12,0"
															VerticalAlignment="Center"
															Command="{ReflectionBinding ElementName=PageSelf, Path=DataContext.OpenOrDownloadCommand}"
															CommandParameter="{Binding .}"
															Classes.Installed="{Binding Installed}"
															Classes.NotInstalled="{Binding !Installed}">
														<Button.Styles>
															<Style Selector="Button.Installed">
																<Style.Setters>
																	<Setter Property="Content"
																			Value="Open" />
																</Style.Setters>
															</Style>
															<Style Selector="Button.NotInstalled">
																<Style.Setters>
																	<Setter Property="Content"
																			Value="Download" />
																</Style.Setters>
															</Style>
														</Button.Styles>
													</Button>
													<Button Content="Uninstall"
															Height="32"
															Width="100"
															Classes="Action"
															Margin="0,0,12,0"
															FontSize="12"
															Padding="0"
															HorizontalContentAlignment="Center"
															VerticalContentAlignment="Center"
															VerticalAlignment="Center"
															Command="{ReflectionBinding ElementName=PageSelf, Path=DataContext.InstallOrUninstallCommand}"
															CommandParameter="{Binding .}"
															Classes.Installed="{Binding Installed}"
															Classes.NotInstalled="{Binding !Installed}">
														<Button.Styles>
															<Style Selector="Button.Installed">
																<Style.Setters>
																	<Setter Property="Background"
																			Value="{StaticResource Danger}" />
																</Style.Setters>
															</Style>
															<Style Selector="Button.NotInstalled">
																<Style.Setters>
																	<Setter Property="Background"
																			Value="{StaticResource Accent}" />
																</Style.Setters>
															</Style>
															<Style Selector="Button.Installed">
																<Style.Setters>
																	<Setter Property="Content"
																			Value="Uninstall" />
																</Style.Setters>
															</Style>
															<Style Selector="Button.NotInstalled">
																<Style.Setters>
																	<Setter Property="Content"
																			Value="Install" />
																</Style.Setters>
															</Style>
														</Button.Styles>
													</Button>
												</StackPanel>
											</StackPanel>
										</Border>

										<!-- Release Info Card -->
										<Border Classes="Card">
											<StackPanel Spacing="4">
												<TextBlock Text="Release Notes"
														   FontWeight="Bold" />
												<hyper:Hyperlink x:Name="ReleaseNotesText"
																 Alias="{Binding Data.ReleaseNotes}"
																 TextWrapping="Wrap"
																 HorizontalAlignment="Left"
																 Url="{Binding Data.ReleaseNotes}" />
												<TextBlock Text="Release Date"
														   FontWeight="Bold"
														   Margin="0,8,0,0" />
												<TextBlock Text="{Binding Data.ReleaseDate}" />
											</StackPanel>
										</Border>

										<!-- Language Versions Card -->
										<Border Classes="Card">
											<StackPanel Spacing="4">
												<TextBlock Text="Runtime Version"
														   FontWeight="Bold" />
												<TextBlock Text="{Binding SdkData.RuntimeVersion}" />
												<TextBlock Text="C# Version"
														   FontWeight="Bold"
														   Margin="0,8,0,0" />
												<TextBlock Text="{Binding SdkData.CsharpVersion}" />
												<TextBlock Text="F# Version"
														   FontWeight="Bold"
														   Margin="0,8,0,0" />
												<TextBlock Text="{Binding SdkData.FsharpVersion}" />
												<TextBlock Text="VB Version"
														   FontWeight="Bold"
														   Margin="0,8,0,0" />
												<TextBlock Text="{Binding SdkData.VbVersion}" />
											</StackPanel>
										</Border>

										<!-- Downloads Card -->
										<Border Classes="Card">
											<StackPanel>
												<TextBlock Text="Downloads"
														   FontWeight="Bold"
														   Margin="0,0,0,8" />
												<ItemsControl ItemsSource="{Binding SdkData.Files}"
															  HorizontalAlignment="Stretch"
															  Background="Transparent">
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="data:FileInfo">
															<Grid Height="50"
																  ColumnDefinitions="60,*"
																  Margin="0,8,8,8">
																<Border Background="#5effffff"
																		Grid.Column="0"
																		Height="50"
																		Width="50"
																		HorizontalAlignment="Left"
																		CornerRadius="25"
																		Padding="2">
																	<TextBlock VerticalAlignment="Center"
																			   HorizontalAlignment="Center"
																			   TextAlignment="Center"
																			   Width="50"
																			   FontSize="30"
																			   Text="{Binding Rid, Converter={StaticResource RidToIconConverter}}" />
																</Border>
																<Border Grid.Column="0"
																		BorderThickness="2"
																		Height="22"
																		Width="22"
																		Margin="0,3,3,0"
																		HorizontalAlignment="Right"
																		VerticalAlignment="Bottom"
																		CornerRadius="10">
																	<Border.BorderBrush>
																		<SolidColorBrush Color="{StaticResource Background}" />
																	</Border.BorderBrush>
																	<Border.Background>
																		<SolidColorBrush Color="{Binding FileName, Converter={StaticResource FileNameToColorConverter}}" />
																	</Border.Background>
																	<TextBlock VerticalAlignment="Center"
																			   HorizontalAlignment="Center"
																			   TextAlignment="Center"
																			   Width="20"
																			   FontSize="12"
																			   FontFamily="{StaticResource LucideIcons}"
																			   Text="{Binding FileName, Converter={StaticResource FileNameToIconConverter}}" />
																</Border>
																<StackPanel Spacing="2"
																			Margin="4,0,0,0"
																			Grid.Column="1"
																			VerticalAlignment="Center">
																	<TextBlock VerticalAlignment="Center"
																			   Text="{Binding Rid}" />
																	<hyper:Hyperlink Alias="{Binding FileName}"
																					 MaxLines="3"
																					 TextWrapping="Wrap"
																					 Url="{Binding Url}" />
																</StackPanel>
															</Grid>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</Border>

										<!-- Visual Studio Support Card -->
										<Border Classes="Card">
											<StackPanel Spacing="4">
												<TextBlock Text="Visual Studio Support"
														   FontWeight="Bold" />
												<TextBlock Text="{Binding SdkData.VsSupport}" />
												<TextBlock Text="{Binding SdkData.VsVersion}" />
												<TextBlock Text="Visual Studio Mac Support"
														   FontWeight="Bold"
														   Margin="0,8,0,0" />
												<TextBlock Text="{Binding SdkData.VsMacSupport}" />
												<TextBlock Text="{Binding SdkData.VsMacVersion}" />
											</StackPanel>
										</Border>
									</StackPanel>
								</StackPanel>
							</ScrollViewer>
						</Grid>
					</Grid>

				</SplitView.Pane>
			</SplitView>
		</Grid>
		<Border IsVisible="{Binding IsBusy}"
				Grid.Row="1"
				Background="#cc605d64"
				VerticalAlignment="Stretch"
				HorizontalAlignment="Stretch">
			<StackPanel VerticalAlignment="Center"
						HorizontalAlignment="Center">
				<Image Width="170"
					   Height="170"
					   anim:ImageBehavior.AnimatedSource="avares://Dots/Assets/Loading.gif" />
				<TextBlock Text="Loading..."
						   FontSize="18"
						   FontFamily="{StaticResource SpaceGroteskBold}"
						   HorizontalAlignment="Center" />
			</StackPanel>
		</Border>
	</Grid>
</Window>