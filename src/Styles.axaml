<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20" Background="#605d64" Width="420">
      <StackPanel Spacing="12">
        <Border Classes="Card">
          <TextBlock Text="Card" />
        </Border>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!--
    Elevation. Every shadow string is three layers in a fixed order:
      inset <top highlight>, <contact>, <ambient>
    Keeping the count and the per-index inset flag identical across the states of
    a selector is what lets BoxShadowsTransition interpolate instead of snapping.
    The negative spread on the ambient layer tucks the blur under the element
    rather than letting it fringe out sideways - that's what keeps it subtle.

    Elev1  inset 0 1 0 0 #14ffffff, 0 1 2 0 #26000000, 0 3 8 -2 #33000000
    Elev2  inset 0 1 0 0 #1Fffffff, 0 2 3 -1 #33000000, 0 6 14 -2 #3D000000
    Elev3  inset 0 1 0 0 #24ffffff, 0 4 6 -2 #38000000, 0 12 24 -4 #47000000
  -->

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="TextBlock.Secondary">
    <Setter Property="Foreground" Value="{StaticResource SubtleForegroundBrush}" />
  </Style>

  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #14ffffff, 0 1 2 0 #26000000, 0 3 8 -2 #33000000" />
  </Style>

  <!--
    The version dots. Their fill is data-bound per major version, so the sheen is
    a fixed translucent overlay rather than a per-color gradient. That works
    because ColorHelper pins every generated color to S=0.62 / L=0.58 - no badge
    is ever near-white or near-black, so one overlay reads the same on all hues.
    The inset layer is a top-only specular, clipped to the corner radius.
  -->
  <Style Selector="Border.Dot">
    <Setter Property="BoxShadow" Value="inset 0 1 1 0 #38ffffff, 0 1 2 0 #33000000, 0 4 8 -2 #3D000000" />
  </Style>

  <Style Selector="Border.DotLarge">
    <Setter Property="BoxShadow" Value="inset 0 1 2 0 #3Dffffff, 0 2 4 -1 #40000000, 0 8 16 -4 #4D000000" />
  </Style>

  <!-- pills are small and already saturated, so two layers - a third reads as a sticker -->
  <Style Selector="Border.Pill">
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #26ffffff, 0 1 2 -1 #33000000" />
  </Style>

  <!-- Button has no BoxShadow of its own, so these go through the template. -->
  <Style Selector="Button.Action /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #24ffffff, 0 1 2 0 #26000000, 0 3 8 -2 #33000000" />
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.Action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #2Effffff, 0 2 3 -1 #33000000, 0 6 14 -2 #3D000000" />
  </Style>

  <!-- pressed flips the inset highlight white -> black, so the button sinks -->
  <Style Selector="Button.Action:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="inset 0 1 2 0 #33000000, 0 0 0 0 #00000000, 0 0 0 0 #00000000" />
  </Style>

  <!--
    Toolbar buttons live inside the elevated bar, so their own shadow would just
    be noise. They get a press response instead, reusing the transform idiom
    already used by the logo and the About window artwork.
  -->
  <Style Selector="Button.Toolbar">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.Toolbar:pressed">
    <Setter Property="RenderTransform" Value="scale(0.93)" />
  </Style>

  <Style Selector="Button.Chrome">
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- The pane toggle overhangs the content, so it casts to the left rather than straight down. -->
  <Style Selector="Button.PaneToggle /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #14ffffff, -1 1 0 0 #26000000, -3 2 10 -3 #3D000000" />
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.PaneToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #1Fffffff, -1 1 0 0 #33000000, -5 3 14 -3 #47000000" />
  </Style>

  <Style Selector="Border.Well">
    <Setter Property="BoxShadow" Value="inset 0 1 3 0 #40000000, inset 0 -1 0 0 #0Fffffff" />
  </Style>
</Styles>
